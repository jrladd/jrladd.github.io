	pages = {4.02--4.22},
	file = {Full Text PDF:/Users/jladd/Zotero/storage/XNHHS8Y5/Langmead et al. - 2021 - Network Analysis + Digital Art History A Roundtable on a Collective Scholarly Experience.pdf:application/pdf},
